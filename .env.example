# Django Secret Key (required in production; do not commit actual production keys)
SECRET_KEY=django-insecure-change-this-in-production-example-key

# Debug mode (True for development, False for production)
DEBUG=True

# Allowed hosts (comma-separated list)
ALLOWED_HOSTS=127.0.0.1,localhost

# Database configuration URL
# SQLite (default for development):
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL example:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecommerce_db

